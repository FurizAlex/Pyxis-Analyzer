{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Pyxis",
	"scopeName": "source.pyxis",
	"patterns": [
		{ "include": "#custom_variable_declaration" },
		{ "include": "#keywords" },
		{ "include": "#custom functions" },
		{ "include": "#prebuilt functions" },
		{ "include": "#special_keywords" },
		{ "include": "#define_header" },
		{ "include": "#functions_definitions" },
		{ "include": "#primitives" },
		{ "include": "#references" },
		{ "include": "#constructs" },
		{ "include": "#jellybeans" },
		{ "include": "#error" },
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#compiler" },
		{ "include": "#standard_libraries" }
	],
	"repository": {
		"custom functions": {
		  "patterns": [
		    {
		      "begin": "\\b(func|inputRecord|thread|actor|class|print)\\b",
		      "beginCaptures": {
		        "1": { "name": "custom.function.control.pyxis" }
		      },
		      "end": "$",
		      "patterns": [
		        { "include": "#keywords" },
		        { "include": "#primitives" },
		        { "include": "#constructs" },
				{ "include": "#references" },
		        { "include": "#strings" },
		        { "include": "#custom functions" },
		        { "include": "#prebuilt functions" },
		        { "include": "#compiler" },
		        { "include": "#standard_libraries" },
				{ "include": "#special_keywords" }
		      ]
		    }
		  ]
		},
		"prebuilt functions": {
		  "patterns": [
		    {
		      "begin": "\\b(defi)\\b",
		      "beginCaptures": {
		        "1": { "name": "custom.prebuilt.control.pyxis" }
		      },
		      "end": "$",
		      "patterns": [
		        { "include": "#keywords" },
		        { "include": "#primitives" },
		        { "include": "#constructs" },
				{ "include": "#references" },
		        { "include": "#strings" },
		        { "include": "#custom functions" },
		        { "include": "#compiler" },
		        { "include": "#standard_libraries" },
				{ "include": "#special_keywords" }
		      ]
		    }
		  ]
		},
		"keywords": {
		  "patterns": [
		    {
		      "begin": "\\b(var|lock|if|else|match|for|while|unif|pass|return|true|false)\\b",
		      "beginCaptures": {
		        "1": { "name": "keyword.control.pyxis" }
		      },
		      "end": "$",
		      "patterns": [
		        { "include": "#keywords" },
		        { "include": "#primitives" },
		        { "include": "#constructs" },
				{ "include": "#references" },
		        { "include": "#custom functions" },
		        { "include": "#prebuilt functions" },
		        { "include": "#strings" },
		        { "include": "#compiler" },
		        { "include": "#standard_libraries" },
				{ "include": "#special_keywords" }
		      ]
		    }
		  ]
		},
		"primitives": {
			"patterns": [{
				"name": "keyword.primitives.pyxis",
				"match": "\\b(Void|Int|Char|String|Float|Class|Array|Physics)\\b"
			}]
		},
		"constructs": {
			"patterns": [{
		    	"name": "support.function.constructs.pyxis",
		    	"match": "\\b(Vector|<get_traits>)\\b"
			}]
		},
		"references": {
			"patterns": [{
		    	"name": "variable.reference.pyxis",
				"match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
			}]
		},
		"special_keywords": {
		  "patterns": [{
		    "begin": "(@(?:extends|wrafs|export|ghost|hotlink|bind|tracker|reference))\\b",
		    "beginCaptures": {
		      "1": { "name": "keyword.other.special.pyxis" }
		    },
		    "end": "$",
		    "patterns": [
		      { "include": "#keywords" },
		      { "include": "#primitives" },
		      { "include": "#constructs" },
			  { "include": "#references" },
		      { "include": "#strings" },
		      { "include": "#custom functions" },
		      { "include": "#prebuilt functions" },
		      { "include": "#compiler" },
		      { "include": "#standard_libraries" }
		    ]
		  }]
		},
		"error": {
			"patterns": [{
				"name": "keyword.standard.error.pyxis",
				"match": "\\b(!>|!?|error)\\b"
			}]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.pyxis",
					"match": ";.*$"
				},
				{
					"name": "comment.block.pyxis",
					"begin": ";\\*",
					"end": "\\*;"
				},
				{
					"name": "comment.line.documentation.pyxis",
					"match": ";;;.*$"
				}
			]
		},
		"functions_definitions": {
		  "patterns": [{
		    "begin": "\\bfunc\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
		    "end": "(?=\\()|$",
		    "name": "meta.function.definition.pyxis",
		    "beginCaptures": {
		      "0": { "name": "keyword.control.funcdef.pyxis" },
		      "1": { "name": "entity.name.function.pyxis" }
		    },
		    "patterns": []
		  }]
		},
		"define_header": {
			"patterns": [{
				"name": "define.header.pyxis",
				"match": "#(Normal|Debuug|Custom)"
			}]
		},
		"compiler": {
			"patterns": [{
				"name": "meta.compiler.pyxis",
				"match": "cc::[a-zA-Z_][a-zA-Z0-9_]*"
			}]
		},
		"standard_libraries" : {
			"patterns": [{
				"name": "support.library.stdlib.pyxis",
				"match": "@[a-zA-Z_][a-zA-Z0-9_]*"
			}]
		},
		"strings": {
			"name": "string.quoted.double.pyxis",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.pyxis",
					"match": "\\\\."
				}
			]
		},
		"jellybeans": {
			"patterns": [
			  {
				"begin": "\\b(lerp|wrap|)\\b",
				"beginCaptures": {
				  "1": { "name": "special.jellybeans.pyxis" }
				},
				"end": "$",
				"patterns": [
				  { "include": "#keywords" },
				  { "include": "#primitives" },
				  { "include": "#constructs" },
				  { "include": "#references" },
				  { "include": "#custom functions" },
				  { "include": "#prebuilt functions" },
				  { "include": "#strings" },
				  { "include": "#compiler" },
				  { "include": "#standard_libraries" }
				]
			  }
			]
		}
	}
}